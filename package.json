{
  "name": "gatherly-event-planner",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node server/dev.ts",
    "build": "npm run typecheck && vite build",
    "start": "node server/index.ts",
    "test": "npm run test:unit && npm run test:components",
    "check": "npm run format:check && npm run architecture:check && npm run lint && npm run build && npm run assets:check && npm test",
    "format:check": "prettier --check src server scripts tests index.html package.json tsconfig.json vite.config.ts vitest.config.ts eslint.config.js",
    "assets:check": "node scripts/check-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src server",
    "test:unit": "node scripts/run-unit.mjs",
    "test:components": "node scripts/run-components.mjs",
    "test:coverage": "node scripts/run-components.mjs",
    "architecture:check": "node scripts/check-architecture.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  }
}
